# Copy to .env for local development (never commit .env).
LIFE_TABLE_NAME=life-api-dev
LIFE_LAKE_BUCKET=life-api-dev-lake-123456789012
LIFE_TIMEZONE=America/New_York
# Locally you can set the key directly; in AWS it is read from SSM via LIFE_API_KEY_PARAM.
LIFE_API_KEY=change-me
AWS_REGION=us-east-1
